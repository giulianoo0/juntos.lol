{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Juntos",
  "version": "0.1.0",
  "identifier": "lol.juntos.app",
  "build": {
    "frontendDist": "../offline"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
