// Grafana Alloy: scrapes the application's metrics endpoint and forwards the
// series to Grafana Cloud.
//
// This is the only piece of the observability setup that runs next to the
// application. There is no Prometheus and no Grafana in the Compose file on
// purpose: the destination is a Grafana Cloud stack, which already stores and
// graphs the series, and running a second copy of both here would cost a
// gigabyte of RAM to answer questions the stack already answers.
//
// Alloy replaced Grafana Agent, which reached end of life on 1 November 2025
// and no longer receives security fixes.
//
// Every credential is read from the environment. Nothing here is a secret and
// nothing here needs to be edited to deploy it. Note that sys.env returns an
// empty string for a variable that is not set rather than failing, so a
// missing token surfaces as a 401 from the remote endpoint and not as a
// configuration error — the Alloy UI on 127.0.0.1:12345 is where that shows.

prometheus.scrape "ss" {
	targets = [{
		// The application's second listener. It is published to the Compose
		// network and to nowhere else, so this is the only thing that can
		// reach it.
		__address__ = sys.env("SS_METRICS_TARGET"),
		instance    = sys.env("SS_INSTANCE"),
	}]
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	job_name        = "ss"
	metrics_path    = "/metrics"
	scrape_interval = "15s"
	// Comfortably under the interval: a scrape that has not answered by then
	// is a stalled process, and the gap it leaves says so.
	scrape_timeout = "10s"
}

prometheus.remote_write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_PROM_URL")

		// Grafana Cloud's metrics endpoint takes the numeric instance id as
		// the basic-auth user and a Cloud Access Policy token as the
		// password. The token needs the metrics:write scope and nothing else.
		basic_auth {
			username = sys.env("GRAFANA_CLOUD_PROM_USER")
			password = sys.env("GRAFANA_CLOUD_PROM_TOKEN")
		}

		// The buffer is what carries a scrape across a blip in the link to
		// Grafana Cloud. Two hours is long enough to survive an outage on
		// their side and short enough that a permanently broken token does
		// not fill the disk trying.
		queue_config {
			max_backoff = "5m"
		}
	}

	// Stamped on every series so a second deployment writing into the same
	// stack stays distinguishable.
	external_labels = {
		app = "ss",
		env = sys.env("SS_ENV"),
	}

	// The write-ahead log lives on a volume, so a restart of this container
	// does not lose the samples it had not yet shipped.
	wal {
		truncate_frequency = "2h"
	}
}
