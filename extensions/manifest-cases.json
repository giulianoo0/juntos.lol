{
 "_doc": "O que um juntos.json pode ser. Go (internal/extension), o host de extensões (extensions/host) e o site (web/src/extensions) leem esta tabela nos testes. accept: base com set aplicado e unset removido; expect diz o resultado normalizado (null = ausente). refuse: base com set, ou replace no lugar do manifesto inteiro.",
 "base": {
  "id": "exemplo",
  "name": "Exemplo",
  "version": "1.0.0",
  "protocol": 1,
  "entry": "dist/index.html",
  "icon": "public/icon.svg",
  "hosts": {
   "connect": [
    "api.exemplo.dev"
   ],
   "images": [
    "img.exemplo.dev"
   ],
   "media": [
    "*.cdn.exemplo.dev"
   ]
  },
  "captcha": "hcaptcha"
 },
 "accept": [
  {
   "case": "o manifesto completo",
   "set": {},
   "expect": {
    "name": "Exemplo",
    "icon": "public/icon.svg",
    "captcha": "hcaptcha",
    "hosts": {
     "connect": [
      "api.exemplo.dev"
     ],
     "images": [
      "img.exemplo.dev"
     ],
     "media": [
      "*.cdn.exemplo.dev"
     ]
    }
   }
  },
  {
   "case": "sem hosts, ícone nem captcha",
   "unset": [
    "hosts",
    "icon",
    "captcha"
   ],
   "expect": {
    "hosts": {
     "connect": [],
     "images": [],
     "media": []
    },
    "icon": null,
    "captcha": null
   }
  },
  {
   "case": "hosts nulo",
   "set": {
    "hosts": null
   },
   "expect": {
    "hosts": {
     "connect": [],
     "images": [],
     "media": []
    }
   }
  },
  {
   "case": "listas de hosts ausentes ou nulas",
   "set": {
    "hosts": {
     "connect": null,
     "images": [
      "img.exemplo.dev"
     ]
    }
   },
   "expect": {
    "hosts": {
     "connect": [],
     "images": [
      "img.exemplo.dev"
     ],
     "media": []
    }
   }
  },
  {
   "case": "ícone e captcha vazios contam como ausentes",
   "set": {
    "icon": "",
    "captcha": ""
   },
   "expect": {
    "name": "Exemplo",
    "icon": null,
    "captcha": null
   }
  },
  {
   "case": "ícone e captcha nulos contam como ausentes",
   "set": {
    "icon": null,
    "captcha": null
   },
   "expect": {
    "name": "Exemplo",
    "icon": null,
    "captcha": null
   }
  },
  {
   "case": "versão de 64 caracteres",
   "set": {
    "version": "vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv"
   }
  },
  {
   "case": "nome com espaços em volta",
   "set": {
    "name": "  Exemplo  "
   },
   "expect": {
    "name": "Exemplo"
   }
  },
  {
   "case": "nome de 64 letras acentuadas",
