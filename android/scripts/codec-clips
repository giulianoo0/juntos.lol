#!/bin/sh
# Writes the codec matrix's 10 s HLS fMP4 clips into <dir>/<clip>/master.m3u8.
#   android/scripts/codec-clips <dir>    then: python3 -m http.server 8077 -d <dir>
set -e
out=${1:?dir}
mkdir -p "$out"
clip() {
  name=$1; shift
  rm -rf "${out:?}/$name"; mkdir -p "$out/$name"
  ffmpeg -hide_banner -loglevel error -y \
    -f lavfi -i testsrc2=size=1920x1080:rate=30:duration=10 \
    -f lavfi -i sine=frequency=440:duration=10:sample_rate=48000 \
    "$@" -g 60 -keyint_min 60 \
    -f hls -hls_time 2 -hls_playlist_type vod -hls_segment_type fmp4 \
    -hls_fmp4_init_filename init.mp4 -hls_segment_filename "$out/$name/seg%02d.m4s" \
    -master_pl_name master.m3u8 "$out/$name/media.m3u8"
  echo "$name"
}
clip h264 -c:v libx264 -preset veryfast -profile:v high -pix_fmt yuv420p -c:a aac -b:a 128k
clip hevc -c:v libx265 -preset veryfast -pix_fmt yuv420p -tag:v hvc1 -x265-params log-level=error -c:a aac -b:a 128k
clip hevc10 -c:v libx265 -preset veryfast -pix_fmt yuv420p10le -profile:v main10 -tag:v hvc1 -x265-params log-level=error -c:a aac -b:a 128k
clip vp9 -c:v libvpx-vp9 -deadline realtime -cpu-used 8 -b:v 3M -pix_fmt yuv420p -c:a libopus -b:a 128k
clip av1 -c:v libsvtav1 -preset 10 -pix_fmt yuv420p -c:a libopus -b:a 128k
